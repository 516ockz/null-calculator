<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Null Electric Calc | Simple</title>

  <style>
    :root{
      --bg:#0b0d12;
      --panel:rgba(255,255,255,.035);
      --bd:rgba(255,255,255,.12);
      --bd2:rgba(255,255,255,.18);
      --txt:#e9eefc;
      --muted:rgba(233,238,252,.62);
      --shadow:0 10px 30px rgba(0,0,0,.35);
      --r2:22px;
      --in-bg:rgba(0,0,0,.25);

      /* blue glow (控えめ) */
      --g1:rgba(70, 160, 255, .18);
      --g2:rgba(70, 160, 255, .40);
      --g3:rgba(70, 160, 255, .85);
    }

    *{ box-sizing:border-box; }
    body{
      margin:0;
      font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Noto Sans JP",Helvetica,Arial,sans-serif;
      background: var(--bg);
      color:var(--txt);
    }
    .wrap{ max-width:980px; margin:0 auto; padding:16px; }

    .top{
      padding:14px 16px;
      background:var(--panel);
      border:1px solid var(--bd);
      border-radius:var(--r2);
      box-shadow:var(--shadow);
      display:flex;
      justify-content:space-between;
      align-items:flex-end;
      gap:12px;
    }
    h1{ margin:0; font-size:18px; font-weight:900; letter-spacing:.2px; }

    .grid{
      display:grid;
      grid-template-columns:1fr;
      gap:12px;
      margin-top:12px;
    }
    @media(min-width:860px){
      .grid{ grid-template-columns:1.08fr .92fr; }
    }

    .card{
      background:var(--panel);
      border:1px solid var(--bd);
      border-radius:var(--r2);
      box-shadow:var(--shadow);
      padding:14px;
    }

    label{
      display:block;
      font-size:12px;
      color:var(--muted);
      margin-bottom:6px;
      font-weight:800;
    }

    .row{ display:flex; gap:10px; flex-wrap:wrap; }
    .row>*{ flex:1 1 180px; }
    .hr{ height:1px; background:rgba(255,255,255,.15); margin:12px 0; }

    /* inputs */
    select,input{
      width:100%;
      padding:11px 12px;
      border-radius:14px;
      border:1px solid var(--bd2);
      background:var(--in-bg);
      color:var(--txt);
      font-size:15px;
      outline:none;
      transition:border-color .15s ease, box-shadow .15s ease;
    }
    input::placeholder{ color:rgba(233,238,252,.35); }

    /* blue focus ring (滲み少なめ) */
    select:focus,
    input:focus{
      border-color:var(--g3);
      box-shadow:
        0 0 0 2px var(--g1),
        0 0 10px rgba(70,160,255,.12);
    }

    /* pill toggles */
    .pillGroup{
      display:flex;
      gap:8px;
      padding:6px;
      border-radius:999px;
      border:1px solid var(--bd);
      background:rgba(0,0,0,.18);
      box-shadow: inset 0 0 0 1px rgba(255,255,255,.03);
    }
    .pill{
      flex:1 1 auto;
      padding:10px 12px;
      border-radius:999px;
      border:1px solid rgba(255,255,255,.12);
      background:rgba(255,255,255,.04);
      color:rgba(233,238,252,.85);
      font-weight:900;
      font-size:13px;
      cursor:pointer;
      user-select:none;
      transition: transform .04s ease, border-color .15s ease, box-shadow .15s ease, background .15s ease, opacity .15s ease;
      text-align:center;
      white-space:nowrap;
    }
    .pill:active{ transform: translateY(1px); }

    /* blue active (滲み控えめ) */
    .pill.active{
      color:var(--txt);
      border-color:var(--g2);
      background:rgba(70,160,255,.10);
      box-shadow:
        0 0 0 2px rgba(70,160,255,.10),
        0 0 12px rgba(70,160,255,.10);
    }
    .pill.locked{ cursor:default; opacity:.75; }

    /* OUTPUT */
    .big{
      font-size:46px;
      font-weight:1000;
      letter-spacing:.2px;
      line-height:1.05;
    }
    .big2{
      margin-top:10px;
      font-size:22px;
      font-weight:950;
      color:rgba(233,238,252,.92);
      line-height:1.2;
    }
    .mini{
      margin-top:12px;
      font-size:12.5px;
      color:rgba(233,238,252,.62);
      line-height:1.6;
      white-space:pre-wrap;
      background:rgba(0,0,0,.22);
      border:1px solid rgba(255,255,255,.10);
      border-radius:14px;
      padding:10px;
    }

    footer{
      margin-top:10px;
      padding-top:10px;
      border-top:1px dashed rgba(255,255,255,.22);
      font-size:12px;
      color:rgba(233,238,252,.55);
    }
  </style>
</head>

<body>
<div class="wrap">
  <div class="top">
    <h1>Null Electric Calc</h1>
  </div>

  <div class="grid">
    <!-- INPUT -->
    <div class="card">
      <div class="row">
        <div>
          <label>Mode</label>
          <div class="pillGroup" role="tablist" aria-label="mode">
            <div class="pill active" id="pillKw"  data-mode="kw-to-a">kW → A</div>
            <div class="pill"        id="pillAmp" data-mode="a-to-sq">A → 推奨sq</div>
            <div class="pill"        id="pillSq"  data-mode="sq-to-a">sq → 許容A</div>
          </div>
          <input type="hidden" id="mode" value="kw-to-a" />
        </div>

        <div>
          <label>Phase</label>
          <div class="pillGroup" role="tablist" aria-label="phase">
            <div class="pill active" id="pillSingle" data-phase="single">単相</div>
            <div class="pill"        id="pillThree"  data-phase="three">三相</div>
          </div>
          <input type="hidden" id="phase" value="single" />
        </div>

        <div id="voltWrap">
          <label>Voltage</label>
          <div class="pillGroup" role="tablist" aria-label="voltage">
            <div class="pill active" id="pillV100" data-v="100">100V</div>
            <div class="pill"        id="pillV200" data-v="200">200V</div>
          </div>
          <input type="hidden" id="voltage" value="100" />
        </div>
      </div>

      <div class="hr"></div>

      <div class="row">
        <div>
          <label>Cable</label>
          <select id="cable">
            <option value="cv">CV</option>
            <option value="cvt">CVT</option>
            <option value="mlfc">MLFC</option>
            <option value="lkgb">LKGB</option>
          </select>
        </div>

        <div id="coresWrap">
          <label>CV Cores</label>
          <select id="cores">
            <option value="1">単芯</option>
            <option value="2">2芯</option>
            <option value="3" selected>3芯</option>
            <option value="4">4芯</option>
          </select>
        </div>
      </div>

      <div class="hr"></div>

      <div id="kwPanel">
        <label>Power (kW)</label>
        <input id="kw" inputmode="decimal" placeholder="5.5" />
      </div>

      <div id="aPanel" style="display:none">
        <label>Current (A)</label>
        <input id="amp" inputmode="decimal" placeholder="30" />
      </div>

      <div id="sqPanel" style="display:none">
        <label>Size (sq)</label>
        <select id="sqSel"></select>
      </div>
    </div>

    <!-- OUTPUT -->
    <div class="card">
      <div class="big" id="outA">—</div>
      <div class="big2" id="outSq">Ready</div>
      <div class="mini" id="outMini">PF=0.85 / 許容電流は表の固定条件</div>
      <footer>© 2025 Null / 516ockz</footer>
    </div>
  </div>
</div>

<script>
(() => {
  const $ = id => document.getElementById(id);
  const PF = 0.85;

  // 許容電流テーブル（固定条件）
  const AMP_CV_40C = {
    2:{1:31,2:28,3:23,4:23}, 3.5:{1:44,2:39,3:33,4:33}, 5.5:{1:58,2:52,3:44,4:44},
    8:{1:72,2:65,3:54,4:54}, 14:{1:100,2:91,3:76,4:76}, 22:{1:130,2:120,3:100,4:100},
    38:{1:190,2:170,3:140,4:140}, 60:{1:255,2:225,3:190,4:190}, 100:{1:355,2:310,3:260,4:260},
    150:{1:455,2:400,3:340,4:340}, 200:{1:545,2:485,3:410,4:410}, 250:{1:620,2:560,3:470,4:470},
    325:{1:725,2:660,3:555,4:555}
  };
  const AMP_CVT_40C = { 8:62, 14:86, 22:110, 38:155, 60:210, 100:290, 150:380, 200:465, 250:535, 325:635 };
  const AMP_MLFC_90C = { 2:34, 3.5:47, 5.5:63, 8:78, 14:113, 22:148, 38:208, 60:279, 100:384, 150:509, 200:605 };
  const AMP_LKGB_100C = { 0.75:23, 1.25:31, 2:44, 3.5:60, 5.5:80, 8:99, 14:143, 22:187, 38:264, 60:353, 100:485 };

  const num = (v) => {
    if (v === null || v === undefined) return null;
    let s = String(v).trim();
    if (!s) return null;
    s = s
      .replace(/[０-９]/g, ch => String.fromCharCode(ch.charCodeAt(0) - 0xFEE0))
      .replace(/[．]/g, ".")
      .replace(/[，]/g, ",")
      .replace(/[－]/g, "-")
      .replace(/,/g, "");
    const x = parseFloat(s);
    return Number.isFinite(x) ? x : null;
  };

  function setActive(groupSelector, activeEl){
    document.querySelectorAll(groupSelector + " .pill").forEach(el=>el.classList.remove("active"));
    activeEl.classList.add("active");
  }

  function setLockedVoltageUI(isThree){
    const v100 = $("pillV100");
    const v200 = $("pillV200");
    if (isThree){
      $("voltage").value = "200";
      v100.style.display = "none";
      v200.style.display = "block";
      v200.classList.add("locked");
      setActive("[aria-label='voltage']", v200);
    } else {
      v100.style.display = "block";
      v200.style.display = "block";
      v200.classList.remove("locked");
      const vv = $("voltage").value === "200" ? v200 : v100;
      setActive("[aria-label='voltage']", vv);
    }
  }

  function showPanels(){
    const mode = $("mode").value;
    $("kwPanel").style.display = (mode==="kw-to-a") ? "block" : "none";
    $("aPanel").style.display  = (mode==="a-to-sq") ? "block" : "none";
    $("sqPanel").style.display = (mode==="sq-to-a") ? "block" : "none";

    const cable = $("cable").value;
    $("coresWrap").style.display = (cable==="cv") ? "block" : "none";
  }

  function listCandidatesForCable(){
    const cable = $("cable").value;
    const keys =
      cable==="cv"  ? Object.keys(AMP_CV_40C) :
      cable==="cvt" ? Object.keys(AMP_CVT_40C) :
      cable==="mlfc"? Object.keys(AMP_MLFC_90C) :
      cable==="lkgb"? Object.keys(AMP_LKGB_100C) : [];
    return keys.map(Number).sort((a,b)=>a-b);
  }

  function getAmpBySq(sq){
    const cable = $("cable").value;
    if (cable==="cv") {
      const cores = parseInt($("cores").value,10);
      return AMP_CV_40C[sq]?.[cores] ?? null;
    }
    if (cable==="cvt") return AMP_CVT_40C[sq] ?? null;
    if (cable==="mlfc") return AMP_MLFC_90C[sq] ?? null;
    if (cable==="lkgb") return AMP_LKGB_100C[sq] ?? null;
    return null;
  }

  function suggestSqByAmp(I){
    if (!Number.isFinite(I) || I<=0) return null;
    const cands = listCandidatesForCable();
    for (const sq of cands){
      const amp = getAmpBySq(sq);
      if (Number.isFinite(amp) && I <= amp) return {sq, amp};
    }
    const maxSq = cands[cands.length-1] ?? null;
    return {sq:null, amp:null, maxSq, maxAmp: maxSq ? getAmpBySq(maxSq) : null};
  }

  function refreshSqOptions(){
    const sel = $("sqSel");
    if (!sel) return;
    const cands = listCandidatesForCable();
    const current = sel.value ? Number(sel.value) : null;
    sel.innerHTML = "";
    cands.forEach(sq=>{
      const opt = document.createElement("option");
      opt.value = String(sq);
      opt.textContent = `${sq} sq`;
      sel.appendChild(opt);
    });
    // できれば前回値、無ければ真ん中寄り
    if (current && cands.includes(current)) {
      sel.value = String(current);
    } else if (cands.length){
      sel.value = String(cands[Math.floor(cands.length/3)]);
    }
  }

  function calc(){
    const mode = $("mode").value;
    const phase = $("phase").value;
    const V = num($("voltage").value);
    const root = (phase==="three") ? Math.sqrt(3) : 1;

    const outA = $("outA");
    const outSq = $("outSq");
    const outMini = $("outMini");

    const cable = $("cable").value.toUpperCase();
    const cores = ($("cable").value==="cv") ? ` ${$("cores").value}C` : "";
    const cableLabel = `${cable}${cores}`;

    // --- mode: sq → 許容A ---
    if (mode === "sq-to-a"){
      const sq = num($("sqSel").value);
      const allowA = Number.isFinite(sq) ? getAmpBySq(sq) : null;

      if (!Number.isFinite(sq) || !Number.isFinite(allowA)){
        outA.textContent = "—";
        outSq.textContent = "Ready";
        outMini.textContent = `${cableLabel} / 許容電流表（固定条件）`;
        return;
      }

      outA.textContent = `${allowA} A`;
      outSq.textContent = `${cableLabel} / ${sq} sq`;
      outMini.textContent =
        ($("cable").value==="mlfc") ? `固定条件: 90℃` :
        ($("cable").value==="lkgb") ? `固定条件: 100℃（注釈想定）` :
        `固定条件: 40℃`;
      return;
    }

    // --- mode: kW → A / A → 推奨sq ---
    let I = null;
    if (mode==="kw-to-a"){
      const kW = num($("kw").value);
      if (Number.isFinite(V) && Number.isFinite(kW)){
        I = (kW*1000) / (V*root*PF);
      }
    } else {
      I = num($("amp").value);
    }

    if (!Number.isFinite(I)){
      outA.textContent = "—";
      outSq.textContent = "Ready";
      outMini.textContent = "PF=0.85 / 許容電流は表の固定条件";
      return;
    }

    const sug = suggestSqByAmp(I);
    if (!sug){
      outA.textContent = `${I.toFixed(2)} A`;
      outSq.textContent = "—";
      outMini.textContent = "テーブル未設定";
      return;
    }

    if (!sug.sq){
      if (mode === "a-to-sq"){
        outA.textContent = "NG";
        outSq.textContent = `最大 ${cableLabel} ${sug.maxSq} sq`;
        outMini.textContent = `許容: ${sug.maxAmp ?? "—"}A / 入力: ${I.toFixed(2)}A`;
      } else {
        outA.textContent = `${I.toFixed(2)} A`;
        outSq.textContent = `NG（最大でも不足）`;
        outMini.textContent = `最大: ${cableLabel} ${sug.maxSq}sq（${sug.maxAmp ?? "—"}A）`;
      }
      return;
    }

    const allowA = sug.amp;
    const sq = sug.sq;

    if (mode === "kw-to-a"){
      outA.textContent = `${I.toFixed(2)} A`;
      outSq.textContent = `${cableLabel} → ${sq} sq`;
      outMini.textContent = `許容電流: ${allowA}A`;
    } else {
      outA.textContent = `${sq} sq`;
      outSq.textContent = `許容電流 ${allowA} A`;
      outMini.textContent = `${cableLabel} / 入力 ${I.toFixed(2)}A`;
    }
  }

  let t;
  function auto(){
    clearTimeout(t);
    t = setTimeout(calc, 60);
  }

  // Mode pills
  function setMode(mode, el){
    $("mode").value = mode;
    setActive("[aria-label='mode']", el);
    showPanels();
    refreshSqOptions();
    auto();
    if (mode==="kw-to-a") $("kw")?.focus();
    if (mode==="a-to-sq") $("amp")?.focus();
    if (mode==="sq-to-a") $("sqSel")?.focus();
  }
  $("pillKw").addEventListener("click", e=>setMode(e.currentTarget.dataset.mode, e.currentTarget));
  $("pillAmp").addEventListener("click", e=>setMode(e.currentTarget.dataset.mode, e.currentTarget));
  $("pillSq").addEventListener("click", e=>setMode(e.currentTarget.dataset.mode, e.currentTarget));

  // Phase pills
  $("pillSingle").addEventListener("click", (e)=>{
    $("phase").value = e.currentTarget.dataset.phase;
    setActive("[aria-label='phase']", e.currentTarget);
    setLockedVoltageUI(false);
    auto();
  });
  $("pillThree").addEventListener("click", (e)=>{
    $("phase").value = e.currentTarget.dataset.phase;
    setActive("[aria-label='phase']", e.currentTarget);
    setLockedVoltageUI(true);
    auto();
  });

  // Voltage pills
  $("pillV100").addEventListener("click", (e)=>{
    if ($("phase").value === "three") return;
    $("voltage").value = e.currentTarget.dataset.v;
    setActive("[aria-label='voltage']", e.currentTarget);
    auto();
  });
  $("pillV200").addEventListener("click", (e)=>{
    if ($("phase").value === "three") return;
    $("voltage").value = e.currentTarget.dataset.v;
    setActive("[aria-label='voltage']", e.currentTarget);
    auto();
  });

  // Other inputs
  ["kw","amp","cores"].forEach(id=>{
    $(id)?.addEventListener("input", auto);
    $(id)?.addEventListener("change", auto);
  });
  $("sqSel").addEventListener("change", auto);
  $("cable").addEventListener("change", ()=>{
    showPanels();
    refreshSqOptions();
    auto();
  });

  // init
  showPanels();
  setLockedVoltageUI(false);
  refreshSqOptions();
  calc();
})();
</script>
</body>
</html>
